{
  "name": "meme-scout",
  "version": "0.1.0",
  "description": "Solana meme-coin monitoring, alerting and point-in-time market recorder",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "probe": "tsx scripts/probe.ts",
    "backup": "bash scripts/backup.sh",
    "restore-drill": "bash scripts/restore-drill.sh",
    "test": "tsx --test tests/*.test.ts",
    "ci": "npm run typecheck && npm test",
    "dashboard": "tsx src/web/server.ts"
  },
  "dependencies": {
    "@solana/web3.js": "^1.95.0",
    "better-sqlite3": "^11.3.0",
    "dotenv": "^16.4.5",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.5.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
