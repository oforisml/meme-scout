# Helius API key — https://helius.dev (free tier is enough to start)
HELIUS_API_KEY=

# Optional Telegram alerts. Create a bot via @BotFather, get your chat id via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional. Jupiter's keyless lite-api still answers but carries a deprecation
# notice dated 2025-12-31; a free key from portal.jup.ag moves us to the keyed
# host (60 req/min) before that bites.
JUPITER_API_KEY=

# Filter thresholds live in src/strategy.config.json (versioned in git),
# NOT here — every assessment stores that file's hash for auditability.

# Storage
DB_PATH=./data/meme-scout.db

# Ingest scope, sized to your Helius plan. THIS IS THE MAIN COST LEVER.
# Helius bills websockets at 20 credits/MB and logsSubscribe delivers every
# transaction touching a program, of which we use well under 1%. Measured:
#   PumpSwap 104 GB/day = 62M credits/month
#   pump.fun  13.5 GB/day = 8.1M credits/month
# against allowances of 1M (free) / 10M ($49) / 100M ($499) per month.
#
#   business  = all venues, incl. post-graduation swaps   (~71M/mo)
#   developer = pump.fun only; graduations still detected  (~8.1M/mo)
#   free      = pump.fun only, duty-cycled under budget    (sampled coverage)
#   custom    = use the venue toggles in strategy.config.json
INGEST_PROFILE=developer

# Monthly credit allowance to stay inside. Free 1000000, Developer 10000000,
# Business 100000000. The recorder meters real usage against this, warns at
# 50/80/95%, sheds the most expensive venue at 95%, and paces ingest so a month
# cannot be burned in a day.
HELIUS_MONTHLY_CREDITS=1000000

# Off-machine dataset backups (FR-G1). An rclone remote + path, e.g.
# "b2:meme-scout-backups". Set up with:  rclone config
# Leave empty to disable backups entirely — the recorder then stays quiet
# rather than alerting about a backup you never asked for.
BACKUP_RCLONE_REMOTE=
